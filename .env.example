# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Public ---
# Canonical public URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Task 011) — Neon project/database: GalkayoUniversity ---
# Pooled connection string used by the app at runtime (least-privilege role)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/GalkayoUniversity?sslmode=require
# Direct (unpooled) connection string used only for migrations (owner role)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/GalkayoUniversity?sslmode=require

# --- Custom auth (Task 012) ---
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET=replace-with-random-secret

# --- Contact email (Task 010) ---
EMAIL_PROVIDER_API_KEY=
CONTACT_DESTINATION_EMAIL=
CONTACT_FROM_EMAIL=

# --- Object storage (Task 017) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
